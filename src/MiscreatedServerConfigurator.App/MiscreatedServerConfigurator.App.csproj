<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>MiscreatedServerConfigurator.App</RootNamespace>
    <AssemblyName>MiscreatedServerConfigurator</AssemblyName>
    <ApplicationTitle>Miscreated Server Configurator</ApplicationTitle>
    <Description>Editor for Miscreated dedicated-server hosting.cfg files.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MiscreatedServerConfigurator.Core\MiscreatedServerConfigurator.Core.csproj" />
  </ItemGroup>

</Project>
