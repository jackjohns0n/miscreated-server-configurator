<UserControl x:Class="MiscreatedServerConfigurator.App.Views.FactionDamageMatrixView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MiscreatedServerConfigurator.App.Views">
  <UserControl.Resources>
    <DataTemplate x:Key="PresentCell">
      <Border Width="76"
              Height="36"
              Margin="1"
              Padding="3,2"
              Background="White"
              BorderBrush="{StaticResource Brush.Line}"
              BorderThickness="1"
              CornerRadius="3"
              ToolTip="{Binding ToolTip}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
          <CheckBox IsChecked="{Binding Row.Enabled, Mode=TwoWay}"
                    VerticalAlignment="Center"
                    Margin="0,0,4,0"
                    ToolTip="Write this multiplier. Unchecked uses the factory default." />
          <TextBox Text="{Binding Row.Value, UpdateSourceTrigger=PropertyChanged}"
                   Width="40"
                   Padding="2,1"
                   FontFamily="Consolas"
                   FontSize="12"
                   VerticalAlignment="Center"
                   SpellCheck.IsEnabled="False"
                   BorderBrush="{StaticResource Brush.Line}" />
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="MissingCell">
      <Border Width="76"
              Height="36"
              Margin="1"
              Background="#F7F9FB"
              BorderBrush="{StaticResource Brush.Line}"
              BorderThickness="1"
              CornerRadius="3"
              ToolTip="{Binding ToolTip}">
        <TextBlock Text="—"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource Brush.Muted}" />
      </Border>
    </DataTemplate>
    <views:DamageCellTemplateSelector x:Key="CellSelector"
                                      Present="{StaticResource PresentCell}"
                                      Missing="{StaticResource MissingCell}" />
  </UserControl.Resources>

  <StackPanel>
    <TextBlock Style="{StaticResource MutedText}"
               Margin="0,0,0,8"
               Text="Each row is the faction dealing damage. Each column is the faction taking it. An unchecked cell is not written, so the server keeps its factory default." />
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="128,0,0,4">
          <ItemsControl ItemsSource="{Binding ColumnHeaders}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Width="78"
                           Text="{Binding}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           FontSize="11"
                           Foreground="{StaticResource Brush.Muted}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,1">
                <TextBlock Width="128"
                           Text="{Binding Label}"
                           VerticalAlignment="Center"
                           FontSize="12" />
                <ItemsControl ItemsSource="{Binding Cells}"
                              ItemTemplateSelector="{StaticResource CellSelector}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </StackPanel>
</UserControl>
