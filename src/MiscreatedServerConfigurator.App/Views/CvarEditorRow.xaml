<UserControl x:Class="MiscreatedServerConfigurator.App.Views.CvarEditorRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Style="{StaticResource Card}">
    <StackPanel>
      <DockPanel LastChildFill="False" Margin="0,0,0,6">
        <CheckBox DockPanel.Dock="Left"
                  IsChecked="{Binding Enabled, Mode=TwoWay}"
                  VerticalAlignment="Center"
                  Content="Use this value"
                  ToolTip="Unchecked CVARs are not written as live settings. The server uses its factory default." />
        <Border DockPanel.Dock="Left" Background="{StaticResource Brush.DangerBg}">
          <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource Badge}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsRequired}" Value="True">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <TextBlock Text="Required" Foreground="{StaticResource Brush.DangerInk}" FontSize="11" />
        </Border>
      </DockPanel>

      <TextBlock Style="{StaticResource KeyName}" Text="{Binding Key}" />
      <TextBlock Style="{StaticResource MutedText}"
                 Margin="0,4,0,0"
                 Text="{Binding Description}"
                 Visibility="{Binding Description, Converter={StaticResource StringToVis}}" />

      <Border Margin="0,8,0,0"
              Padding="10,8"
              Background="{StaticResource Brush.InfoBg}"
              BorderBrush="{StaticResource Brush.Line}"
              BorderThickness="1"
              CornerRadius="4"
              Visibility="{Binding InformationalNote, Converter={StaticResource StringToVis}}">
        <TextBlock Text="{Binding InformationalNote}" TextWrapping="Wrap" Foreground="{StaticResource Brush.InfoInk}" />
      </Border>

      <DockPanel Margin="0,8,0,0" LastChildFill="False">
        <TextBlock DockPanel.Dock="Left"
                   Style="{StaticResource MutedText}"
                   VerticalAlignment="Center"
                   Text="{Binding TemplateValueLabel}"
                   Visibility="{Binding TemplateValueLabel, Converter={StaticResource StringToVis}}" />
        <Button DockPanel.Dock="Left"
                Margin="12,0,0,0"
                Style="{StaticResource ToolbarButton}"
                Content="Use reference value"
                Command="{Binding UseTemplateValueCommand}"
                Visibility="{Binding HasTemplateValue, Converter={StaticResource BoolToVis}}" />
      </DockPanel>

      <Grid Margin="0,8,0,0">
        <Grid.Style>
          <Style TargetType="Grid">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsSteamUgc}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Grid.Style>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox x:Name="PlainBox"
                 Grid.Column="0"
                 Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}">
          <TextBox.Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource InputBox}">
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsSecret}" Value="True" />
                    <Condition Binding="{Binding RevealSecret}" Value="False" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Collapsed" />
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </TextBox.Style>
        </TextBox>
        <PasswordBox x:Name="SecretBox"
                     Grid.Column="0"
                     FontFamily="Consolas"
                     FontSize="13"
                     Padding="8,6"
                     MinHeight="32"
                     BorderBrush="{StaticResource Brush.Line}"
                     PasswordChanged="SecretBox_OnPasswordChanged">
          <PasswordBox.Style>
            <Style TargetType="PasswordBox">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsSecret}" Value="True" />
                    <Condition Binding="{Binding RevealSecret}" Value="False" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </PasswordBox.Style>
        </PasswordBox>
        <Button Grid.Column="1"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Click="Reveal_Click">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
              <Setter Property="Content" Value="Show" />
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsSecret}" Value="True">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RevealSecret}" Value="True">
                  <Setter Property="Content" Value="Hide" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
      </Grid>

      <StackPanel Margin="0,8,0,0">
        <StackPanel.Style>
          <Style TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsSteamUgc}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Style>
        <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,6" Text="Workshop file ids, in load order. Separate them with commas and no spaces." />
        <ItemsControl ItemsSource="{Binding WorkshopIds}" Margin="0,0,0,8">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <DockPanel Margin="0,0,0,4">
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource ToolbarButton}"
                        Content="Remove"
                        Margin="8,0,0,0"
                        Command="{Binding DataContext.RemoveWorkshopCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}" />
                <TextBlock FontFamily="Consolas" VerticalAlignment="Center" Text="{Binding}" />
              </DockPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <DockPanel LastChildFill="True">
          <Button DockPanel.Dock="Right"
                  Style="{StaticResource ToolbarButton}"
                  Content="Add"
                  Margin="8,0,0,0"
                  Command="{Binding AddWorkshopCommand}" />
          <TextBox Style="{StaticResource InputBox}"
                   Text="{Binding WorkshopDraft, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="A numeric Workshop file id, a Workshop URL, or several separated by commas." />
        </DockPanel>
        <TextBlock Margin="0,6,0,0"
                   Foreground="{StaticResource Brush.DangerInk}"
                   Text="{Binding WorkshopError}"
                   TextWrapping="Wrap"
                   Visibility="{Binding WorkshopError, Converter={StaticResource StringToVis}}" />
        <TextBlock Margin="0,8,0,0"
                   Style="{StaticResource MutedText}"
                   FontFamily="Consolas"
                   Text="{Binding LivePreview}" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
