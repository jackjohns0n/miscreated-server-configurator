<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>MiscreatedServerConfigurator.Core</RootNamespace>
    <AssemblyName>MiscreatedServerConfigurator.Core</AssemblyName>
    <Description>hosting.cfg parsing, CVAR catalog, and writing for Miscreated dedicated servers.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\samples\hosting.cfg">
      <LogicalName>MiscreatedServerConfigurator.Core.Resources.hosting.cfg</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
  </ItemGroup>

</Project>
