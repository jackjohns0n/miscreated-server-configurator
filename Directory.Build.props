<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Default</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Lets a net8.0-windows WPF project compile on Linux CI. Ship the app from Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Deterministic>true</Deterministic>
    <Version>0.1.0-dev</Version>
    <Authors>jackjohns0n</Authors>
    <Product>Miscreated Server Configurator</Product>
    <Copyright>Copyright (c) 2026 jackjohns0n</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
